{
  "schemaVersion": 1,
  "id": "crosshair-corsair-justfatlard",
  "version": "${version}",
  "name": "Crosshair Corsair",
  "description": "Tweaks for what your crosshair points at: a styleable outline and reach-around placing",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/crosshair-corsair"
  },
  "license": "MIT",
  "icon": "assets/crosshair-corsair-justfatlard/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "justfatlard.crosshair_corsair.Main"
    ]
  },
  "mixins": [
    "crosshair-corsair-justfatlard.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25"
  },
  "breaks": {
    "pandorical": "<15.0.0"
  },
  "suggests": {
    "pandorical": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://github.com/sponsors/fatlard1993"
      }
    }
  }
}
